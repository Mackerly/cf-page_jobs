# 本地开发用：复制为 .dev.vars（wrangler pages dev 会自动读取，不会上传到 Cloudflare）
# 线上不读这个文件：所有变量与机密都在 Pages 控制台 Settings → Variables and Secrets 添加

# —— 机密（线上建议用 Secret 类型，即加密存储）——
# 会话签名密钥，至少 32 字节随机串（openssl rand -hex 32）
SESSION_SECRET=local-dev-secret-please-change-0123456789abcdef
# 首次初始化口令，浏览器访问 /setup?token=dev-setup-token 创建第一个管理员
SETUP_TOKEN=dev-setup-token

# —— 普通变量（线上用 Plaintext 类型）——
# 站点名称：页面标题、页头品牌、页脚都会替换；不填则用默认「招聘信息管理系统」
SITE_NAME=招聘信息管理系统-洲到人社炎陵站
# 是否开放自助注册（true / false）
ALLOW_REGISTER=true
# PBKDF2 迭代次数，免费版 Pages Functions CPU 吃紧时可降到 50000
PBKDF2_ITERATIONS=100000
